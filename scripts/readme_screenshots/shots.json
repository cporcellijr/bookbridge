[
 {
  "name": "library",
  "path": "/",
  "width": 1440,
  "height": 900,
  "pre": [
   "fetch('/').then(() => new Promise(r => setTimeout(r, 12000))).then(() => 'warm')",
   "fetch('/account/interface',{method:'POST',body:new URLSearchParams({ui_mode:'new'})}).then(r=>r.status)",
   "fetch('/account/display',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({\"UI_THEME\": \"night\", \"UI_LIBRARY_STYLE\": \"cards\", \"UI_SHOW_HERO\": \"true\"})}).then(r=>r.status)"
  ],
  "actions": [
   "(() => { const i = document.querySelector('#library-hero .hero-cover img'); if (!i) return 'none'; const u = (i.dataset.thumbUrl || i.getAttribute('src') || '').split('?')[0].replace('/covers/thumb/', '/covers/'); i.onerror = null; i.loading = 'eager'; i.hidden = false; i.src = u; return u; })()",
   "(() => { const g = document.querySelector('#series-grouping-toggle'); if (g && g.checked) g.click(); document.documentElement.dataset.input = 'touch'; return 'ok'; })()",
   "([...document.querySelectorAll('body *')].filter(e => e.children.length === 0 && /^Build (dev|v)/.test(e.textContent.trim())).forEach(e => e.style.visibility = 'hidden'), 'hid-build')"
  ],
  "actionWait": 2000
 },

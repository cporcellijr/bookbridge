# Personal configuration with credentials
docker-compose.yml*

.run
# Data directories
/data/
*.db
*.json
# Test fixtures are real captured data the suite depends on -- without them
# tests/test_segment_fit.py's real-data regressions fail on a fresh clone.
!tests/fixtures/*.json
epub_cache/

# Python
__pycache__/
*.py[cod]
*.class
*.so
.Python
env/
venv/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
cwa_debug.log

# Local artifacts
.tmp/
dist/

# Local System Rules
.cursorrules
BRANCH_STATUS.md
BRANCH_STATUS_ARCHIVE.md
CLAUDE.md
AGENTS.md
.claude/

# Automated review pipeline (local-only: OpenCode + OmniRoute scheduled reviewer)
opencode.json
docs/automated-review/
scripts/automated-review/

# Omni-bridge MCP handoff (local-only: Claude/Codex <-> OmniRoute implementation bridge)
.mcp.json.example
docs/omni-bridge.md
scripts/omni_bridge/
tests/test_omni_mcp_server.py

# Local planning/scratch documents (agent working notes, not shipped docs)
plans/
phase1_schema_design.md
pytest_output.txt

# Retired reports-site artifacts may still exist locally and contain private data.
reports_site/docs/
reports_site/site/
diagnostics_receiver/.env

# Credential-encryption key (never commit; lives in DATA_DIR at runtime)
secret.key
**/secret.key
